{
  "title": "SPLAT-STREET · 真实侧栏品牌和会话树",
  "group": "工作区与会话",
  "pluginCss": [
    "@deepseek-ai/dsh-client-ui-sidebar",
    "@deepseek-ai/dsh-client-ui-workspace",
    "@deepseek-ai/dsh-client-ui-settings-general",
    "@deepseek-ai/dsh-client-ui-settings-account"
  ],
  "variants": [
    {
      "id": "light",
      "mode": "light",
      "window": "420,780"
    },
    {
      "id": "dark",
      "mode": "dark",
      "window": "420,780"
    }
  ],
  "assertions": [
    {
      "message": "品牌槽在侧栏内可见且不越界",
      "expression": "(()=>{const b=document.querySelector('.splat-ui-brand__name'),s=document.querySelector('nav[aria-label]');return !!b&&!!s&&b.getBoundingClientRect().width>70&&b.getBoundingClientRect().left>=0&&b.getBoundingClientRect().right<innerWidth})()"
    },
    {
      "message": "侧栏保留真实宿主280px宽度，品牌与会话区域不越界",
      "expression": "(()=>{const r=document.querySelector('.splat-ui-brand__mark').closest('button').parentElement.parentElement.getBoundingClientRect();return r.width===280&&r.height>=500&&r.right<=innerWidth})()"
    }
  ]
}
