{
  "title": "模型列表 · 单层圆角搜索框",
  "group": "浮层与反馈",
  "pluginCss": ["@deepseek-ai/dsh-client-ui-model-selection"],
  "variants": [
    { "id": "light", "mode": "light", "window": "700,500" },
    { "id": "dark", "mode": "dark", "window": "700,500" },
    { "id": "mobile", "mode": "light", "window": "390,600" }
  ],
  "assertions": [
    {
      "message": "搜索框仅外壳描边，内部输入透明无套框",
      "expression": "(()=>{const i=document.querySelector('[role=searchbox]'),s=getComputedStyle(i),p=getComputedStyle(i.parentElement);return s.borderTopWidth==='0px'&&s.backgroundColor==='rgba(0, 0, 0, 0)'&&s.boxShadow==='none'&&parseFloat(p.borderRadius)===12&&i.parentElement.getBoundingClientRect().height===36})()"
    },
    {
      "message": "结果内层不重复绘制边框与阴影，列表不越界",
      "expression": "(()=>{const e=document.querySelector('[role=menu]'),s=getComputedStyle(e),r=e.getBoundingClientRect();return s.borderTopWidth==='0px'&&s.boxShadow==='none'&&r.left>=0&&r.right<=innerWidth})()"
    },
    {
      "message": "当前模型的选中面与深色文字保持清晰",
      "expression": "(()=>{const s=getComputedStyle(document.querySelector('[aria-checked=true]'));return s.color==='rgb(18, 18, 18)'&&s.backgroundColor===(document.body.hasAttribute('data-ds-dark-theme')?'rgb(68, 240, 40)':'rgb(30, 220, 0)')})()"
    }
  ]
}
