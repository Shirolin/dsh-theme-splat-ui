{
  "title": "右侧栏 deliverables diff 的语法配色（浅色面板）",
  "group": "代码与交付",
  "pluginCss": ["@deepseek-ai/dsh-client-ui-deliverables"],
  "variants": [
    {
      "id": "light",
      "mode": "light",
      "window": "760,520"
    },
    {
      "id": "dark",
      "mode": "dark",
      "window": "760,520"
    }
  ],
  "assertions": [
    {
      "message": "关键字与字符串使用不同语法色",
      "expression": "getComputedStyle(document.querySelector('.kw')).color!==getComputedStyle(document.querySelector('.str')).color"
    },
    {
      "message": "diff正文保持透明背景而非额外套框",
      "expression": "getComputedStyle(document.querySelector('[data-review-view]')).backgroundColor==='rgba(0, 0, 0, 0)'"
    },
    {
      "message": "diff正文没有被设置为20px代码岛内边距",
      "expression": "getComputedStyle(document.querySelector('[data-review-view]')).paddingTop!=='20px'"
    }
  ]
}
