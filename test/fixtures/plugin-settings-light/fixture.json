{
  "title": "插件管理 · 亮色开关边界与阅读面",
  "group": "设置与外观",
  "pluginCss": ["@deepseek-ai/dsh-client-ui-plugin-manager"],
  "assertions": [
    {
      "message": "开关保持宿主36×20轨道与16px滑块",
      "expression": "[...document.querySelectorAll('[role=switch]')].every(e=>{const r=e.getBoundingClientRect(),t=e.firstElementChild.getBoundingClientRect();return r.width===36&&r.height===20&&t.width===16&&t.height===16})"
    },
    {
      "message": "插件卡片有独立阅读面",
      "expression": "[...document.querySelectorAll('li[data-plugin-item],li[data-plugin-package]')].every(e=>getComputedStyle(e).backgroundColor!=='rgba(0, 0, 0, 0)')"
    }
  ],
  "variants": [
    {
      "id": "light",
      "mode": "light",
      "window": "820,540"
    },
    {
      "id": "dark",
      "mode": "dark",
      "window": "820,540"
    }
  ]
}
