{
  "title": "快捷键弹窗 · 搜索输入（真实 DSH DOM）",
  "group": "浮层与反馈",
  "pluginCss": ["@deepseek-ai/dsh-client-ui-shortcuts"],
  "assertions": [
    {
      "message": "搜索输入内层透明，无额外边框或阴影",
      "expression": "(()=>{const e=document.querySelector('[role=search] > input'),s=getComputedStyle(e);return s.borderTopWidth==='0px'&&s.backgroundColor==='rgba(0, 0, 0, 0)'&&s.boxShadow==='none'})()"
    },
    {
      "message": "搜索外壳承担焦点提示",
      "expression": "(()=>{const e=document.querySelector('[role=search] > input');e.focus();const s=getComputedStyle(e.parentElement);return document.activeElement===e&&s.boxShadow!=='none'})()"
    }
  ],
  "variants": [
    {
      "id": "light",
      "mode": "light",
      "window": "700,700"
    },
    {
      "id": "dark",
      "mode": "dark",
      "window": "700,700"
    }
  ]
}
