{
  "title": "输入菜单 · 指令别名、选中对比与窄屏边界",
  "group": "浮层与反馈",
  "pluginCss": ["@deepseek-ai/dsh-client-ui-input-trigger"],
  "variants": [
    {
      "id": "light",
      "mode": "light",
      "window": "720,800"
    },
    {
      "id": "dark",
      "mode": "dark",
      "window": "720,800"
    },
    {
      "id": "mobile",
      "mode": "light",
      "window": "390,844"
    }
  ],
  "assertions": [
    {
      "message": "菜单不越出视口，选项保留独立行高",
      "expression": "(()=>{const m=document.querySelector('[data-trigger-menu]'),r=m.getBoundingClientRect(),rows=[...m.querySelectorAll('[role=option]')];return r.left>=0&&r.right<=innerWidth+1&&r.top>=0&&rows.length>0&&rows.every(e=>e.getBoundingClientRect().height>=32&&getComputedStyle(e).flexShrink==='0')})()"
    },
    {
      "message": "选中项是荧光绿墨面与深色字",
      "expression": "(()=>{const e=document.querySelector('[role=option][aria-selected=true]'),s=getComputedStyle(e);return s.backgroundColor===(document.body.hasAttribute('data-ds-dark-theme')?'rgb(68, 240, 40)':'rgb(30, 220, 0)')&&s.color==='rgb(18, 18, 18)'})()"
    }
  ]
}
